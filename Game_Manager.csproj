    <Resource Include="img\动作游戏.png" />
    <Resource Include="img\角色扮演.png" />
    <Resource Include="img\策略游戏.png" />
    <Resource Include="img\射击游戏.png" />
    <Resource Include="img\未分类.png" />
    <Resource Include="img\档案.jpg" />
    <Resource Include="img\golden.png" />
    <Resource Include="img\silver.png" />
    <Resource Include="img\copper.png" />
  </ItemGroup>

  <ItemGroup>
