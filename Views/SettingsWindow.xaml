<Window x:Class="Game_Manager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="设置"
        Height="320" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Microsoft YaHei UI, Roboto, Segoe UI">

    <Grid Margin="10">
        <Border CornerRadius="12" Background="#121B2D">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="16"
                                  Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12"
                Background="#121B2D"
                BorderBrush="#243452"
                BorderThickness="1">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,500,300" RadiusX="12" RadiusY="12" />
            </Border.Clip>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Height="40"
                      Background="#0A0F1D"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <materialDesign:PackIcon Kind="Cog"
                                                     Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Foreground="#5D8CFF" />
                            <TextBlock Text="设置"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#EAF0FF"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Click="CloseButton_Click"
                                Width="46" Height="40"
                                ToolTip="关闭"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent">
                                        <materialDesign:PackIcon Kind="WindowClose"
                                                                 Width="16" Height="16"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#AEB8CC" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="24,20,24,24">
                    <TextBlock Text="分类管理"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#9DA9BF"
                               Margin="0,0,0,12" />

                    <Border Padding="16"
                            CornerRadius="10"
                            Background="#0E192B"
                            BorderBrush="#1D2A42"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="添加自定义分类，用于整理你的游戏库。"
                                       FontSize="12"
                                       Foreground="#8894AA"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14" />
                            <Button Command="{Binding AddCategoryCommand}"
                                    Height="38"
                                    HorizontalAlignment="Left"
                                    Padding="16,0"
                                    Background="#24304A"
                                    BorderBrush="#294A82"
                                    BorderThickness="1"
                                    Foreground="#EAF0FF"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="添加分类" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
