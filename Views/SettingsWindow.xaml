<Window x:Class="Game_Manager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="设置"
        Height="700" Width="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Microsoft YaHei UI, Roboto, Segoe UI">

    <Grid Margin="10">
        <Border CornerRadius="12" Background="#121B2D">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="16"
                                  Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12"
                Background="#121B2D"
                BorderBrush="#243452"
                BorderThickness="1">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,640,680" RadiusX="12" RadiusY="12" />
            </Border.Clip>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Height="40"
                      Background="#0A0F1D"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <materialDesign:PackIcon Kind="Cog"
                                                     Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Foreground="#5D8CFF" />
                            <TextBlock Text="设置"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#EAF0FF"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Click="CloseButton_Click"
                                Width="46" Height="40"
                                ToolTip="关闭"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent">
                                        <materialDesign:PackIcon Kind="WindowClose"
                                                                 Width="16" Height="16"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#AEB8CC" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Margin="24,20,24,24">
                        <TextBlock Text="卡片尺寸"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#9DA9BF"
                                   Margin="0,0,0,12" />

                        <Border Padding="16"
                                CornerRadius="10"
                                Background="#0E192B"
                                BorderBrush="#1D2A42"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="拖动滑块或直接输入数值。勾选「自动」的高度表示由内容撑开，取消勾选后才能手动设定。改完点下方「应用」才会生效。"
                                           FontSize="12"
                                           Foreground="#8894AA"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="宽度" FontSize="11" Foreground="#6F7D95" />
                                    <TextBlock Grid.Column="4" Text="高度" FontSize="11" Foreground="#6F7D95" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="网格 · 普通"
                                               FontSize="12" Foreground="#C8D2E4" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Minimum="170" Maximum="400" TickFrequency="1" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True"
                                            Value="{Binding CardSizeDraft.GridCardWidth}" />
                                    <TextBox Grid.Column="2" VerticalAlignment="Center" MaxLength="3"
                                             TextAlignment="Center"
                                             Text="{Binding CardSizeDraft.GridCardWidth}" />
                                    <CheckBox Grid.Column="3" Content="自动" FontSize="12"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding CardSizeDraft.GridCardHeightAuto}" />
                                    <Slider Grid.Column="4" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Minimum="240" Maximum="560" TickFrequency="1" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True"
                                            IsEnabled="{Binding CardSizeDraft.GridCardHeightEnabled}"
                                            Value="{Binding CardSizeDraft.GridCardHeight}" />
                                    <TextBox Grid.Column="5" VerticalAlignment="Center" MaxLength="3"
                                             TextAlignment="Center"
                                             IsEnabled="{Binding CardSizeDraft.GridCardHeightEnabled}"
                                             Text="{Binding CardSizeDraft.GridCardHeight}" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="网格 · 归档"
                                               FontSize="12" Foreground="#C8D2E4" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Minimum="160" Maximum="380" TickFrequency="1" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True"
                                            Value="{Binding CardSizeDraft.ArchiveGridCardWidth}" />
                                    <TextBox Grid.Column="2" VerticalAlignment="Center" MaxLength="3"
                                             TextAlignment="Center"
                                             Text="{Binding CardSizeDraft.ArchiveGridCardWidth}" />
                                    <CheckBox Grid.Column="3" Content="自动" FontSize="12"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding CardSizeDraft.ArchiveGridCardHeightAuto}" />
                                    <Slider Grid.Column="4" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Minimum="220" Maximum="520" TickFrequency="1" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True"
                                            IsEnabled="{Binding CardSizeDraft.ArchiveGridCardHeightEnabled}"
                                            Value="{Binding CardSizeDraft.ArchiveGridCardHeight}" />
                                    <TextBox Grid.Column="5" VerticalAlignment="Center" MaxLength="3"
                                             TextAlignment="Center"
                                             IsEnabled="{Binding CardSizeDraft.ArchiveGridCardHeightEnabled}"
                                             Text="{Binding CardSizeDraft.ArchiveGridCardHeight}" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="列表 · 普通"
                                               FontSize="12" Foreground="#C8D2E4" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="3" Content="自动" FontSize="12"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding CardSizeDraft.ListRowHeightAuto}" />
                                    <Slider Grid.Column="4" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Minimum="60" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True"
                                            IsEnabled="{Binding CardSizeDraft.ListRowHeightEnabled}"
                                            Value="{Binding CardSizeDraft.ListRowHeight}" />
                                    <TextBox Grid.Column="5" VerticalAlignment="Center" MaxLength="3"
                                             TextAlignment="Center"
                                             IsEnabled="{Binding CardSizeDraft.ListRowHeightEnabled}"
                                             Text="{Binding CardSizeDraft.ListRowHeight}" />
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="列表 · 归档"
                                               FontSize="12" Foreground="#C8D2E4" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="3" Content="自动" FontSize="12"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding CardSizeDraft.ArchiveListRowHeightAuto}" />
                                    <Slider Grid.Column="4" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Minimum="92" Maximum="220" TickFrequency="1" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True"
                                            IsEnabled="{Binding CardSizeDraft.ArchiveListRowHeightEnabled}"
                                            Value="{Binding CardSizeDraft.ArchiveListRowHeight}" />
                                    <TextBox Grid.Column="5" VerticalAlignment="Center" MaxLength="3"
                                             TextAlignment="Center"
                                             IsEnabled="{Binding CardSizeDraft.ArchiveListRowHeightEnabled}"
                                             Text="{Binding CardSizeDraft.ArchiveListRowHeight}" />
                                </Grid>

                                <Button Command="{Binding ApplyCardSizesCommand}"
                                        Content="应用"
                                        Height="34"
                                        Width="88"
                                        HorizontalAlignment="Right"
                                        Background="#2F6BFF"
                                        BorderBrush="#3F78F6"
                                        Foreground="White"
                                        materialDesign:ButtonAssist.CornerRadius="8"
                                        Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="分类管理"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#9DA9BF"
                                   Margin="0,18,0,12" />

                        <Border Padding="16"
                                CornerRadius="10"
                                Background="#0E192B"
                                BorderBrush="#1D2A42"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="添加自定义分类，用于整理你的游戏库。"
                                           FontSize="12"
                                           Foreground="#8894AA"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14" />
                                <Button Command="{Binding AddCategoryCommand}"
                                        Height="38"
                                        HorizontalAlignment="Left"
                                        Padding="16,0"
                                        Background="#24304A"
                                        BorderBrush="#294A82"
                                        BorderThickness="1"
                                        Foreground="#EAF0FF"
                                        materialDesign:ButtonAssist.CornerRadius="8"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="添加分类" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="数据管理"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#9DA9BF"
                                   Margin="0,18,0,12" />

                        <Border Padding="16"
                                CornerRadius="10"
                                Background="#0E192B"
                                BorderBrush="#1D2A42"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="查看本地数据库文件，便于备份或迁移游戏数据。"
                                           FontSize="12"
                                           Foreground="#8894AA"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{Binding DatabaseDirectoryDisplay}"
                                           FontSize="11"
                                           Foreground="#6F7D95"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14" />
                                <Button Command="{Binding OpenDatabaseFolderCommand}"
                                        Height="38"
                                        HorizontalAlignment="Left"
                                        Padding="16,0"
                                        Background="#24304A"
                                        BorderBrush="#294A82"
                                        BorderThickness="1"
                                        Foreground="#EAF0FF"
                                        materialDesign:ButtonAssist.CornerRadius="8"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="打开数据库目录" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="关于"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#9DA9BF"
                                   Margin="0,18,0,12" />

                        <Border Padding="16"
                                CornerRadius="10"
                                Background="#0E192B"
                                BorderBrush="#1D2A42"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="版本"
                                               FontSize="12"
                                               Foreground="#8894AA"
                                               Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding AppVersionDisplay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#EAF0FF"
                                               ToolTip="{Binding AppBuildDisplay}"
                                               Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="许可证"
                                               FontSize="12"
                                               Foreground="#8894AA" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding AppLicenseDisplay}"
                                               FontSize="12"
                                               Foreground="#C8D2E4" />
                                </Grid>

                                <Button Command="{Binding OpenProjectUrlCommand}"
                                        Height="34"
                                        HorizontalAlignment="Left"
                                        Padding="14,0"
                                        Background="#24304A"
                                        BorderBrush="#294A82"
                                        BorderThickness="1"
                                        Foreground="#EAF0FF"
                                        ToolTip="{Binding ProjectUrl}"
                                        materialDesign:ButtonAssist.CornerRadius="8"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Github" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="访问项目主页" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
