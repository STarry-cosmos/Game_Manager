<Window x:Class="Game_Manager.Views.MemorySceneViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="记忆场景 · 大图模式"
        Height="720" Width="1080"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Microsoft YaHei UI, Roboto, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="10">
        <Border CornerRadius="12" Background="#0B1220">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="20"
                                  Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12"
                Background="#0B1220"
                BorderBrush="#2A364C"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Height="44"
                      Background="#0A0F1D"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <materialDesign:PackIcon Kind="ImageMultiple"
                                                     Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Foreground="#C5A059" />
                            <TextBlock Text="记忆场景 · 大图模式"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#EAF0FF"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                            <TextBlock Text="{Binding MemorySceneCounterDisplay}"
                                       FontSize="12"
                                       Foreground="#8B95A8"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Click="CloseButton_Click"
                                Width="46" Height="44"
                                ToolTip="关闭"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent">
                                        <materialDesign:PackIcon Kind="WindowClose"
                                                                 Width="16" Height="16"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#AEB8CC" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="16,12,16,8" Background="#101826">
                    <Border BorderBrush="#243044" BorderThickness="1" CornerRadius="8" Background="#0E1522">
                        <Grid>
                            <TextBlock Text="暂无图片，点击下方「添加图片」开始收藏"
                                       Foreground="#8B95A8"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMemoryScenes}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Image Source="{Binding CurrentMemorySceneImage}"
                                   Stretch="Uniform"
                                   Margin="24"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="Image_MouseLeftButtonDown">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMemoryScenes}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <Button Command="{Binding PrevMemorySceneCommand}"
                                    Width="40" Height="40"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"
                                    ToolTip="上一张"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#66141B28" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="20">
                                                        <materialDesign:PackIcon Kind="ChevronLeft"
                                                                                 Width="22" Height="22"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#EAF0FF" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#AA1A2333" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.25" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanNavigateMemoryScenes}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding NextMemorySceneCommand}"
                                    Width="40" Height="40"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    ToolTip="下一张"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#66141B28" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="20">
                                                        <materialDesign:PackIcon Kind="ChevronRight"
                                                                                 Width="22" Height="22"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#EAF0FF" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#AA1A2333" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.25" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanNavigateMemoryScenes}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Padding="16,10,16,16"
                        Background="#0A0F1D"
                        BorderBrush="#1E2A3C"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding AddMemorySceneCommand}"
                                Height="36"
                                MinWidth="120"
                                Margin="0,0,10,0"
                                Background="#1A2943"
                                BorderBrush="#2A3F5F"
                                Foreground="#EAF0FF"
                                FontSize="12"
                                Padding="14,0"
                                Cursor="Hand"
                                materialDesign:ButtonAssist.CornerRadius="6"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ImagePlus"
                                                         Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0" />
                                <TextBlock Text="添加图片" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteCurrentMemorySceneCommand}"
                                Height="36"
                                MinWidth="120"
                                Background="#3A1A1F"
                                BorderBrush="#5A2A32"
                                Foreground="#FFD0D4"
                                FontSize="12"
                                Padding="14,0"
                                Cursor="Hand"
                                materialDesign:ButtonAssist.CornerRadius="6"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline"
                                                         Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0" />
                                <TextBlock Text="删除当前" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
