<Window x:Class="Game_Manager.Views.ChangeCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="修改分类"
        Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Microsoft YaHei UI, Roboto, Segoe UI">

    <Grid Margin="10">
        <Border CornerRadius="12"
                Background="{DynamicResource MaterialDesignPaper}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="16"
                                  Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12"
                Background="{DynamicResource MaterialDesignPaper}">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,400,400" RadiusX="12" RadiusY="12" />
            </Border.Clip>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Height="36"
                      Background="{DynamicResource MaterialDesignToolBarBackground}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <materialDesign:PackIcon Kind="Tag"
                                                     Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBlock Text="修改分类"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Click="CloseButton_Click"
                                Width="46" Height="36"
                                ToolTip="关闭"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent">
                                        <materialDesign:PackIcon Kind="WindowClose"
                                                                 Width="16" Height="16"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource MaterialDesignBody}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="24,20,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="选择游戏分类"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Margin="0,0,0,12" />

                    <ListBox x:Name="CategoryListBox"
                             Grid.Row="1"
                             BorderThickness="1"
                             BorderBrush="#334155"
                             Padding="4"
                             Margin="0,0,0,20"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,6">
                                    <Image Source="{Binding IconPath}"
                                           Width="16" Height="16"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="取消"
                                Width="100"
                                Height="38"
                                IsCancel="True"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                Margin="0,0,10,0" />
                        <Button Content="确定"
                                Width="100"
                                Height="38"
                                Click="OkButton_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="10" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
