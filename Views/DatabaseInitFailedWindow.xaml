<Window x:Class="Game_Manager.Views.DatabaseInitFailedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="数据库初始化失败"
        Height="280" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="10">
        <Border CornerRadius="12" Background="#121B2D">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="16"
                                  Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12"
                Background="#121B2D"
                BorderBrush="#243452"
                BorderThickness="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DatabaseOff"
                                             Width="22" Height="22"
                                             Foreground="#F0A35E"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="数据库初始化失败"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#EAF0FF"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="无法初始化本地游戏库，主界面暂不可用。你可以重试、打开数据目录排查，或退出程序。"
                               TextWrapping="Wrap"
                               Foreground="#9DA9BF"
                               FontSize="12"
                               Margin="0,0,0,12" />
                    <Border Background="#0E192B"
                            BorderBrush="#1D2A42"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <TextBlock x:Name="ErrorMessageText"
                                   TextWrapping="Wrap"
                                   Foreground="#E0A8A8"
                                   FontSize="12" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button Content="打开数据目录"
                            Width="110"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="OpenFolderButton_Click"
                            Background="#24304A"
                            BorderBrush="#294A82"
                            Foreground="#EAF0FF"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Cursor="Hand" />
                    <Button Content="重试"
                            Width="80"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="RetryButton_Click"
                            Background="#2F6BFF"
                            BorderBrush="#3F78F6"
                            Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Cursor="Hand"
                            IsDefault="True" />
                    <Button Content="退出"
                            Width="80"
                            Height="34"
                            Click="ExitButton_Click"
                            Background="#3A455C"
                            BorderBrush="#4A566E"
                            Foreground="#EAF0FF"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Cursor="Hand"
                            IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
