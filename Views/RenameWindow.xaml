<Window x:Class="Game_Manager.Views.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名游戏" Height="240" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E"
        Foreground="White"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="输入新的游戏名称：" Foreground="White" Margin="0,0,0,10" />
        
        <TextBox x:Name="NameTextBox"
                 Grid.Row="1"
                 Height="40"
                 Padding="8"
                 Background="#FF2A2A2A"
                 Foreground="White"
                 BorderBrush="#FF3A82F6"
                 BorderThickness="1"
                 Margin="0,0,0,16"
                 FontSize="14" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定"
                    Width="100"
                    Height="36"
                    Background="#FF3A82F6"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OkButton_Click"
                    Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="取消"
                    Width="100"
                    Height="36"
                    Background="#FF555555"
                    Foreground="White"
                    BorderThickness="0"
                    IsCancel="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
