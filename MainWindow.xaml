                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="11"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Play Button -->
                                            <Button Command="{Binding PlayCommand}"
                                                    Margin="0,10,0,0"
