<Window x:Class="Game_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:Game_Manager.ViewModels"
        mc:Ignorable="d"
        Title="Game Manager"
        Height="800" Width="1200"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="Microsoft YaHei UI, Roboto, Segoe UI">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#0B1020" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#0A0F1D" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#22304A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8894AA" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#C9D4E8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3D73F5" />
        <LinearGradientBrush x:Key="MainPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121B2D" Offset="0" />
            <GradientStop Color="#0B1222" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172238" Offset="0" />
            <GradientStop Color="#10192A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonBlueBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A82FF" Offset="0" />
            <GradientStop Color="#2F66E8" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B6C0D4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1BFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#C8D5F0" />
            <Setter Property="Background" Value="#14213A" />
            <Setter Property="BorderBrush" Value="#294A82" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
        </Style>

        <Style x:Key="PrimaryGameButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource ButtonBlueBrush}" />
            <Setter Property="BorderBrush" Value="#3F78F6" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="7" />
        </Style>

        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="#121B2F" />
            <Setter Property="BorderBrush" Value="#1B2A43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#C8D5F0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3E83" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#315FC2" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#182743" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2A4776" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#244991" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryIconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <Style x:Key="CategoryToggleIconImageStyle" TargetType="Image" BasedOn="{StaticResource CategoryIconImageStyle}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>

        <Style x:Key="LayoutToggleIconImageStyle" TargetType="Image" BasedOn="{StaticResource CategoryIconImageStyle}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <Style x:Key="CategoryCollapsedIconImageStyle" TargetType="Image" BasedOn="{StaticResource CategoryIconImageStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryCollapsedFallbackIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="GamepadVariant" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="#6E92F5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                        <Condition Binding="{Binding IconPath}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryExpandedIconImageStyle" TargetType="Image" BasedOn="{StaticResource CategoryIconImageStyle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryExpandedFallbackIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="GamepadVariant" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#6E92F5" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryExpandedContentStyle" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryToggleExpandedStyle" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryToggleCollapsedIconStyle" TargetType="Image" BasedOn="{StaticResource CategoryToggleIconImageStyle}">
            <Setter Property="Source" Value="/img/分类.png" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategorySidebarTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryItemTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" 
                      
                      />
    </WindowChrome.WindowChrome>

    <!-- Outer container with padding for shadow -->
    <Grid x:Name="RootGrid" Margin="8">
        <!-- Shadow + rounded corners -->
        <Border CornerRadius="14"
                Background="{StaticResource PageBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="22"
                                  Opacity="0.55" Color="#05070D" />
            </Border.Effect>
        </Border>

        <!-- Content (same rounded corners, clips children) -->
        <Border x:Name="ContentBorder" CornerRadius="14"
                Background="{StaticResource PageBackgroundBrush}">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,1184,784" RadiusX="14" RadiusY="14" />
            </Border.Clip>
            <Grid Background="{StaticResource PageBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <!-- Custom Title Bar -->
                <Grid Grid.Row="0" Grid.ColumnSpan="3"
                      Background="{StaticResource TitleBarBrush}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel LastChildFill="False">
                        <!-- App title -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                    VerticalAlignment="Center" Margin="14,0,0,0">
                            <Ellipse Width="4" Height="4" Fill="#39496A" VerticalAlignment="Center" />
                            <Ellipse Width="4" Height="4" Fill="#39496A" VerticalAlignment="Center" Margin="4,0,8,0" />
                            <TextBlock Text="Game Manager"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#CAD4E8"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Window control buttons -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right">
                            <Button Click="MinimizeButton_Click"
                                    Width="36" Height="32"
                                    ToolTip="最小化"
                                    Style="{StaticResource ChromeButtonStyle}">
                                <materialDesign:PackIcon Kind="WindowMinimize"
                                                         Width="13" Height="13"
                                                         Foreground="#AEB8CC" />
                            </Button>
                            <Button x:Name="MaximizeBtn"
                                    Click="MaximizeButton_Click"
                                    Width="36" Height="32"
                                    ToolTip="最大化"
                                    Style="{StaticResource ChromeButtonStyle}">
                                <materialDesign:PackIcon x:Name="MaxIcon"
                                                         Kind="WindowMaximize"
                                                         Width="12" Height="12"
                                                         Foreground="#AEB8CC" />
                            </Button>
                            <Button Click="CloseButton_Click"
                                    Width="40" Height="32"
                                    ToolTip="关闭"
                                    Style="{StaticResource ChromeButtonStyle}">
                                <materialDesign:PackIcon Kind="WindowClose"
                                                         Width="13" Height="13"
                                                         Foreground="#AEB8CC" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Header -->
                <Border Grid.Row="1" Grid.ColumnSpan="3"
                        Margin="12,12,12,0"
                        Padding="16,12"
                        CornerRadius="12"
                        Background="{StaticResource MainPanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Width="38" Height="38"
                                    CornerRadius="10"
                                    Background="#10234A"
                                    BorderBrush="#326BF4"
                                    BorderThickness="1.5">
                                <materialDesign:PackIcon Kind="GamepadVariant"
                                                         Width="24" Height="24"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#5D8CFF" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="游戏管理"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#F4F7FF" />
                                <TextBlock Text="管理你的游戏库，启动精彩游戏"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Height="51">
                            <Border Width="185"
                                    Height="46"
                                    Margin="0,0,12,0"
                                    CornerRadius="7"
                                    Background="#0D1526"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Magnify"
                                                             Width="16" Height="16"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="搜索游戏..."
                                             Style="{StaticResource MaterialDesignTextBox}"
                                             FontSize="11"
                                             Foreground="#D8E2F8"
                                             CaretBrush="#5D8CFF"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>
                            <ComboBox Width="142"
                                      Height="46"
                                      Margin="0,0,12,0"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}"
                                      Padding="10,0"
                                      Foreground="#D8E2F8"
                                      Background="#0D1526"
                                      BorderBrush="{StaticResource PanelBorderBrush}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            <Button Command="{Binding ToggleSortDirectionCommand}"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Width="90"
                                    Margin="0,0,12,0"
                                    IsEnabled="{Binding IsSortDirectionEnabled}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Sync" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SortDirectionLabel}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddGameCommand}"
                                    Style="{StaticResource PrimaryGameButtonStyle}"
                                    Width="100"
                                    Padding="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="83">
                                    <materialDesign:PackIcon Kind="PlusCircle" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="添加游戏" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Category Sidebar -->
                <Border x:Name="CategorySidebar"
                        Grid.Row="2" Grid.Column="0"
                        Width="190"
                        Margin="12,12,0,0"
                        Padding="12"
                        CornerRadius="10"
                        Background="{StaticResource MainPanelBrush}"
                        BorderBrush="#1D2A42"
                        BorderThickness="1">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button Height="34"
                                    Padding="0"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="ToggleCategorySidebarButton_Click"
                                    ToolTip="收缩分类栏"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">
                                    <Grid Style="{StaticResource CategoryToggleExpandedStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="分类"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#F4F7FF"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   Style="{StaticResource CategorySidebarTextStyle}" />
                                        <Image Grid.Column="1"
                                               Source="/img/分类.png"
                                               Margin="0,0,10,0"
                                               Style="{StaticResource CategoryToggleIconImageStyle}" />
                                    </Grid>
                                    <Image Style="{StaticResource CategoryToggleCollapsedIconStyle}" />
                                </Grid>
                            </Button>
                            <TextBlock Text="按分类查看游戏"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource CategorySidebarTextStyle}" />
                        </StackPanel>

                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource GlassButtonStyle}"
                                Height="36"
                                Padding="0"
                                Margin="0,12,0,0"
                                ToolTip="添加分类"
                                Command="{Binding AddCategoryCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="添加分类"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CategorySidebarTextStyle}" />
                            </StackPanel>
                        </Button>

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CategoryButtonStyle}"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Height="36"
                                            VerticalContentAlignment="Center">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="重命名分类"
                                                          Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                                                          Command="{Binding PlacementTarget.Tag.RenameCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="删除分类"
                                                          Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                                                          Foreground="#FFEF5350"
                                                          Command="{Binding PlacementTarget.Tag.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                            <Image Source="{Binding IconPath}"
                                                   Style="{StaticResource CategoryCollapsedIconImageStyle}" />
                                            <materialDesign:PackIcon Style="{StaticResource CategoryCollapsedFallbackIconStyle}" />
                                            <Grid Style="{StaticResource CategoryExpandedContentStyle}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding IconPath}"
                                                       Style="{StaticResource CategoryExpandedIconImageStyle}" />
                                                <materialDesign:PackIcon Style="{StaticResource CategoryExpandedFallbackIconStyle}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#EAF0FF"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource CategoryItemTextStyle}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CountDisplay}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           Style="{StaticResource CategoryItemTextStyle}" />
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Game Cards ScrollViewer -->
                <Border Grid.Row="2" Grid.Column="1"
                        Margin="8,12,0,0"
                        Padding="10,8"
                        CornerRadius="10"
                        Background="{StaticResource MainPanelBrush}"
                        BorderBrush="#1D2A42"
                        BorderThickness="1">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                        <TextBlock Text="{Binding CurrentCategoryName}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#F4F7FF"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentCategoryGameCountDisplay}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="6,1,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  materialDesign:ScrollViewerAssist.BubbleVerticalScroll="True">
                        <ItemsControl x:Name="GameItemsControl" ItemsSource="{Binding Games}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card UniformCornerRadius="16"
                                                     Margin="10"
                                                     Width="240"
                                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                                     Background="{StaticResource CardPanelBrush}"
                                                     Cursor="Hand"
                                                     PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                                     MouseMove="Card_MouseMove"
                                                     PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp">
                                    <materialDesign:Card.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="重命名" Command="{Binding RenameCommand}" />
                                            <MenuItem Header="更改封面" Command="{Binding ChangeCoverCommand}" />
                                            <MenuItem Header="打开所在路径" Command="{Binding OpenFolderCommand}" />
                                            <Separator />
                                            <MenuItem Header="删除" Command="{Binding DeleteCommand}" Foreground="#FFEF5350" />
                                        </ContextMenu>
                                    </materialDesign:Card.ContextMenu>
                                    <Grid>
                                        <Border CornerRadius="16"
                                                BorderBrush="#4E82FF"
                                                BorderThickness="2"
                                                Background="#223D7A"
                                                Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVisibility}}"
                                                IsHitTestVisible="False" />
                                        <DockPanel LastChildFill="True" MouseLeftButtonUp="OnCardClicked">
                                        <!-- Cover Image -->
                                        <Grid Width="220" Height="124" Margin="12,12,12,0"
                                              DockPanel.Dock="Top" ClipToBounds="True">
                                            <Border CornerRadius="10" ClipToBounds="True" Background="#0B1020">
                                                <Image Source="{Binding CoverImage}"
                                                       Stretch="UniformToFill"
                                                       SnapsToDevicePixels="True"
                                                       VerticalAlignment="Top" />
                                            </Border>
                                            <Border CornerRadius="10" ClipToBounds="True"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                                    Background="#B8000000">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="GamepadVariant"
                                                                             Width="32" Height="32"
                                                                             HorizontalAlignment="Center"
                                                                             Foreground="#F8FAFF" />
                                                    <TextBlock Text="游戏中..."
                                                               Foreground="White"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Card Content -->
                                        <StackPanel Margin="14,12,14,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#EEF3FF"
                                                       TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="..."
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top" />
                                            </Grid>
                                            <TextBlock Text="{Binding ExecutablePath}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="36" />

                                            <!-- Stats Row -->
                                            <Border Margin="0,10,0,0"
                                                    Padding="8,6"
                                                    Background="#10192A"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#8291A9" />
                                                        <TextBlock Text="{Binding CurrentSessionDisplay}"
                                                                   Foreground="#D9E3F7"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,4,0,0">
                                                        <materialDesign:PackIcon Kind="CalendarClock" Width="14" Height="14"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="#8291A9" />
                                                        <TextBlock Text="{Binding LastPlayedDisplay}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="11"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Play Button -->
                                            <Button Command="{Binding PlayCommand}"
                                                    Margin="0,10,0,0"
                                                    Content="启动游戏"
                                                    materialDesign:ButtonAssist.CornerRadius="10"
                                                    Height="36">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryGameButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Content" Value="游戏中……" />
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1"
                                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  materialDesign:ScrollViewerAssist.BubbleVerticalScroll="True">
                        <ItemsControl x:Name="GameListItemsControl" ItemsSource="{Binding Games}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel IsItemsHost="True" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,1"
                                            Padding="10,10"
                                            Cursor="Hand"
                                            Tag="GameListRow"
                                            PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                            MouseMove="Card_MouseMove"
                                            PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp"
                                            MouseLeftButtonUp="OnCardClicked">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#06101F" />
                                                <Setter Property="BorderBrush" Value="#17243A" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#4E82FF" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                        <Setter Property="Background" Value="#101A2D" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="135" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="145" />
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="38" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="18" Height="18"
                                                    CornerRadius="4"
                                                    Background="#3D73F5"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding DisplayIndex}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <Grid Grid.Column="1" Width="118" Height="64" HorizontalAlignment="Left" ClipToBounds="True">
                                                <Border CornerRadius="4" ClipToBounds="True" Background="#0B1020">
                                                    <Image Source="{Binding CoverImage}"
                                                           Stretch="UniformToFill"
                                                           SnapsToDevicePixels="True" />
                                                </Border>
                                                <Border CornerRadius="4"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                                        Background="#B8000000">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="GamepadVariant"
                                                                                 Width="18" Height="18"
                                                                                 HorizontalAlignment="Center"
                                                                                 Foreground="#F8FAFF" />
                                                        <TextBlock Text="游戏中..."
                                                                   Foreground="White"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#EEF3FF"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ExecutablePath}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           Margin="0,5,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ClockOutline"
                                                                         Width="15" Height="15"
                                                                         Foreground="#8291A9"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,2,8,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CurrentSessionDisplay}"
                                                               Foreground="#EAF0FF"
                                                               FontSize="13"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="累计时长"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="10"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CalendarClock"
                                                                         Width="15" Height="15"
                                                                         Foreground="#8291A9"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,2,8,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding LastPlayedDisplay}"
                                                               Foreground="#EAF0FF"
                                                               FontSize="13"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="最后运行"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="10"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="5"
                                                    Command="{Binding PlayCommand}"
                                                    Height="32"
                                                    Width="96"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource PrimaryGameButtonStyle}"
                                                    materialDesign:ButtonAssist.CornerRadius="5">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Play" Width="13" Height="13" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ButtonText}" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="6"
                                                    Width="30" Height="30"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#AEB8CC"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Click="MoreMenuButton_Click"
                                                    ToolTip="更多操作">
                                                <TextBlock Text="..." FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="重命名" Command="{Binding RenameCommand}" />
                                                        <MenuItem Header="更改封面" Command="{Binding ChangeCoverCommand}" />
                                                        <MenuItem Header="打开所在路径" Command="{Binding OpenFolderCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="删除" Command="{Binding DeleteCommand}" Foreground="#FFEF5350" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Detail Panel -->
                <materialDesign:Card Grid.Row="2" Grid.Column="2"
                                     Margin="8,12,16,0"
                                     Padding="22"
                                     UniformCornerRadius="16"
                                     Background="{StaticResource CardPanelBrush}"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     Visibility="{Binding IsGameSelected, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Detail Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="24" Height="24"
                                                         VerticalAlignment="Center"
                                                         Foreground="#89A4D8" />
                                <TextBlock Text="游戏详情"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#EEF3FF"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Separator Margin="0,0,0,16"
                                       Background="#24324C" />

                            <!-- Game Name -->
                            <TextBlock Text="游戏名称"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                            <TextBlock Text="{Binding SelectedGame.Name}"
                                       Foreground="#EAF0FF"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,16" />

                            <!-- Category -->
                            <TextBlock Text="分类"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                            <TextBlock Text="{Binding SelectedGame.CategoryDisplayName}"
                                       Foreground="#EAF0FF"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,4,0,8" />
                            <Button Command="{Binding SelectedGame.ChangeCategoryCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Content="修改"
                                    Width="64"
                                    Height="32"
                                    FontSize="12"
                                    Foreground="#4488FF"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16"
                                    materialDesign:ButtonAssist.CornerRadius="8" />

                            <!-- Path -->
                            <TextBlock Text="所在路径"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                            <TextBlock Text="{Binding SelectedGame.ExecutablePath}"
                                       Foreground="#CBD6EA"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Command="{Binding SelectedGame.OpenFolderCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="打开"
                                        Width="64"
                                        Height="32"
                                        FontSize="12"
                                        Foreground="#4488FF"
                                        Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="8" />

                                <Button Command="{Binding SelectedGame.ChangePathCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="修改"
                                        Width="64"
                                        Height="32"
                                        FontSize="12"
                                        Foreground="#4488FF"
                                        materialDesign:ButtonAssist.CornerRadius="8" />
                            </StackPanel>

                            <!-- Play Time -->
                            <TextBlock Text="累计时长"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                <materialDesign:PackIcon Kind="ClockOutline"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Foreground="#7F8EA5"
                                                         Margin="0,0,6,0" />
                                <TextBlock Text="{Binding SelectedGame.CurrentSessionDisplay}"
                                           Foreground="#EAF0FF"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Last Played -->
                            <TextBlock Text="最后运行日期"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="Medium" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,24">
                                <materialDesign:PackIcon Kind="CalendarClock"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Foreground="#7F8EA5"
                                                         Margin="0,0,6,0" />
                                <TextBlock Text="{Binding SelectedGame.LastPlayedDisplay}"
                                           Foreground="#EAF0FF"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Separator Margin="0,0,0,16"
                                       Background="#24324C" />

                            <!-- Actions -->
                            <TextBlock Text="操作"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Margin="0,0,0,10" />
                            <StackPanel Orientation="Vertical">
                                <Button Command="{Binding SelectedGame.PlayCommand}"
                                        Style="{StaticResource PrimaryGameButtonStyle}"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        Height="38"
                                        Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedGame.ButtonText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SelectedGame.RenameCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        Height="38"
                                        Background="#24304A"
                                        BorderBrush="#24304A"
                                        Foreground="#EAF0FF"
                                        Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" VerticalAlignment="Center" />
                                        <TextBlock Text="重命名" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SelectedGame.ChangeCoverCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        Height="38"
                                        Background="#24304A"
                                        BorderBrush="#24304A"
                                        Foreground="#EAF0FF"
                                        Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImageEdit" Width="18" Height="18" VerticalAlignment="Center" />
                                        <TextBlock Text="更改封面" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SelectedGame.DeleteCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        Height="38"
                                        Background="#EA3943"
                                        BorderBrush="#EA3943"
                                        Foreground="White"
                                        Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" VerticalAlignment="Center" />
                                        <TextBlock Text="删除游戏" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </materialDesign:Card>

                <!-- Bottom Status Bar -->
                <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="18,0,18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="25" Height="25"
                                CornerRadius="6"
                                Background="#10234A"
                                BorderBrush="#326BF4"
                                BorderThickness="1">
                            <materialDesign:PackIcon Kind="GamepadVariant"
                                                     Width="16" Height="16"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="#5D8CFF" />
                        </Border>
                        <TextBlock Text="{Binding TotalGameCountDisplay}"
                                   FontSize="11"
                                   Foreground="#9DA9BF"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalGameTimeDisplay}"
                                   FontSize="11"
                                   Foreground="#9DA9BF"
                                   Margin="22,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Width="46" Height="32"
                                Style="{StaticResource PrimaryGameButtonStyle}"
                                ToolTip="网格视图"
                                Command="{Binding ShowGridViewCommand}"
                                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="/img/网格.png" Style="{StaticResource LayoutToggleIconImageStyle}" />
                        </Button>
                        <Button Width="40" Height="32"
                                Style="{StaticResource GlassButtonStyle}"
                                ToolTip="网格视图"
                                Padding="0"
                                Command="{Binding ShowGridViewCommand}"
                                Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="/img/网格.png" Style="{StaticResource LayoutToggleIconImageStyle}" />
                        </Button>
                        <Button Width="40" Height="32"
                                Margin="6,0,0,0"
                                Style="{StaticResource GlassButtonStyle}"
                                ToolTip="列表视图"
                                Command="{Binding ShowListViewCommand}"
                                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="/img/分类.png" Style="{StaticResource LayoutToggleIconImageStyle}" />
                        </Button>
                        <Button Width="46" Height="32"
                                Margin="6,0,0,0"
                                Style="{StaticResource PrimaryGameButtonStyle}"
                                ToolTip="列表视图"
                                Command="{Binding ShowListViewCommand}"
                                Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="/img/分类.png" Style="{StaticResource LayoutToggleIconImageStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
