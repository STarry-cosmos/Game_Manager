                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="10"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CalendarClock"
                                                                         Width="15" Height="15"
                                                                         Foreground="#8291A9"
