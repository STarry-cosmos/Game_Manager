                                                           Text="..."
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top" />
                                            </Grid>
                                            <TextBlock Text="{Binding ExecutablePath}"
                                                       Foreground="{StaticResource MutedTextBrush}"
