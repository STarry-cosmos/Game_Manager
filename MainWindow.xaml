                                                        VerticalAlignment="Center"
                                                        Margin="4,0,12,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#F7F1E4"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           FontFamily="Georgia, Times New Roman, Microsoft YaHei UI"
                                                           TextTrimming="CharacterEllipsis" />

                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                    <materialDesign:PackIcon Kind="ClockOutline"
                                                                             Width="13" Height="13"
                                                                             Foreground="{StaticResource ArchiveMutedBrush}"
                                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TotalPlayTimeCompactDisplay}"
                                                               Margin="5,0,0,0"
                                                               Foreground="{StaticResource ArchiveMutedBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center" />
                                                    <Border Width="1"
                                                            Height="11"
                                                            Margin="10,0"
                                                            Background="#3A4558"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ArchivedAtListDisplay}"
                                                               Foreground="{StaticResource ArchiveMutedBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,3,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStar1Filled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,3,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStar2Filled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,3,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStar3Filled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,3,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStar4Filled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:PackIcon Width="13" Height="13">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStar5Filled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </StackPanel>
                                            </StackPanel>

                                            <Image Grid.Column="3"
                                                   Source="{Binding MedalImagePath}"
                                                   Style="{StaticResource ArchiveListMedalImageStyle}"
                                                   ToolTip="{Binding MedalTierText, StringFormat=评级：{0}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Detail Panel -->
                <materialDesign:Card Grid.Row="2" Grid.Column="2"
                                     Margin="8,12,16,0"
                                     Padding="14,12"
                                     UniformCornerRadius="10"
                                     Background="{StaticResource CardPanelBrush}"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     Visibility="{Binding IsGameSelected, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Detail header: title + close button -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="游戏详情"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#F2F6FF"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsArchiveView, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button Command="{Binding ClearSelectionCommand}"
                                    Width="24" Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTip="关闭详情"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="DetailCloseBd"
                                                Background="Transparent"
                                                CornerRadius="6">
                                            <materialDesign:PackIcon Kind="Close"
                                                                     Width="13" Height="13"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="#AEB8CC" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DetailCloseBd" Property="Background" Value="#24304A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Active game detail panel -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsArchiveView, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="147" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="147"
                                            Height="83"
                                            CornerRadius="7"
                                            Background="#0B1020"
                                            BorderBrush="#32486E"
                                            BorderThickness="1"
                                            helpers:CornerRadiusClip.Enabled="True"
                                            SnapsToDevicePixels="True">
                                        <Image Source="{Binding SelectedGame.CoverImage}"
                                               Stretch="UniformToFill"
                                               SnapsToDevicePixels="True"
                                               VerticalAlignment="Top"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGame.Name}"
                                                   Foreground="#F2F6FF"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="44" />
                                        <Border Margin="0,7,0,0"
                                                Padding="8,3"
                                                CornerRadius="10"
                                                Background="#1B2A44"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding SelectedGame.CategoryDisplayName}"
                                                       Foreground="#DCE7F9"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="180" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource DetailSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="游戏信息" Style="{StaticResource DetailSectionTitleStyle}" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="FolderOpen"
                                                                     Width="13" Height="13"
                                                                     Foreground="#93A5BF"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="安装路径"
                                                       Style="{StaticResource DetailInfoLabelStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedGame.ExecutablePath}"
                                                       Style="{StaticResource DetailInfoValueStyle}"
                                                       FontSize="10"
                                                       ToolTip="{Binding SelectedGame.ExecutablePath}" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="80,-4,0,8">
                                            <Button Command="{Binding SelectedGame.OpenFolderCommand}"
                                                    Style="{StaticResource DetailMiniActionButtonStyle}"
                                                    Content="打开目录"
                                                    Margin="0,0,6,0" />
                                            <Button Command="{Binding SelectedGame.ChangePathCommand}"
                                                    Style="{StaticResource DetailMiniActionButtonStyle}"
                                                    Content="修改路径" />
                                        </StackPanel>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="GamepadVariant"
                                                                     Width="13" Height="13"
                                                                     Foreground="#93A5BF"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="分类"
                                                       Style="{StaticResource DetailInfoLabelStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedGame.CategoryDisplayName}"
                                                       Style="{StaticResource DetailInfoValueStyle}" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Monitor"
                                                                     Width="13" Height="13"
                                                                     Foreground="#93A5BF"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="平台"
                                                       Style="{StaticResource DetailInfoLabelStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="本地游戏"
                                                       Style="{StaticResource DetailInfoValueStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="游戏统计" Style="{StaticResource DetailSectionTitleStyle}" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="ClockOutline"
                                                                     Width="13" Height="13"
                                                                     Foreground="#93A5BF"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="累计时长"
                                                       Style="{StaticResource DetailInfoLabelStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedGame.CurrentSessionDisplay}"
                                                       Style="{StaticResource DetailInfoValueStyle}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="CalendarClock"
                                                                     Width="13" Height="13"
                                                                     Foreground="#93A5BF"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="最后运行"
                                                       Style="{StaticResource DetailInfoLabelStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedGame.LastPlayedDisplay}"
                                                       Style="{StaticResource DetailInfoValueStyle}" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="CalendarPlus"
                                                                     Width="13" Height="13"
                                                                     Foreground="#93A5BF"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="添加时间"
                                                       Style="{StaticResource DetailInfoLabelStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedGame.AddedAtDisplay}"
                                                       Style="{StaticResource DetailInfoValueStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DetailSectionStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="操作" Style="{StaticResource DetailSectionTitleStyle}" />

                                        <Button Command="{Binding SelectedGame.PlayCommand}"
                                                Style="{StaticResource PrimaryGameButtonStyle}"
                                                Height="30"
                                                Margin="0,0,0,8"
                                                ToolTip="{Binding SelectedGame.PlayButtonToolTip}"
                                                ToolTipService.ShowOnDisabled="True"
                                                materialDesign:ButtonAssist.CornerRadius="5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Play"
                                                                         Width="12" Height="12"
                                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SelectedGame.ButtonText}"
                                                           Margin="6,0,0,0"
                                                           FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,8">
                                            <Button Command="{Binding SelectedGame.RenameCommand}"
                                                    Style="{StaticResource DetailSecondaryActionButtonStyle}"
                                                    Margin="0,0,5,6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="12" Height="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="重命名" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding SelectedGame.ChangeCategoryCommand}"
                                                    Style="{StaticResource DetailSecondaryActionButtonStyle}"
                                                    Margin="5,0,0,6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Tag" Width="12" Height="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="更改分类" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding SelectedGame.ChangeCoverCommand}"
                                                    Style="{StaticResource DetailSecondaryActionButtonStyle}"
                                                    Margin="0,0,5,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="ImageEdit" Width="12" Height="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="更改封面" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding SelectedGame.OpenFolderCommand}"
                                                    Style="{StaticResource DetailSecondaryActionButtonStyle}"
                                                    Margin="5,0,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="FolderOpen" Width="12" Height="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="打开目录" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>

                                        <Button Command="{Binding SelectedGame.ArchiveCommand}"
                                                Style="{StaticResource DetailSecondaryActionButtonStyle}"
                                                Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Archive" Width="12" Height="12" VerticalAlignment="Center" />
                                                <TextBlock Text="归档游戏" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding SelectedGame.DeleteCommand}"
                                                Style="{StaticResource DetailDangerActionButtonStyle}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Delete" Width="12" Height="12" VerticalAlignment="Center" />
                                                <TextBlock Text="删除游戏" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Archived game detail panel -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsArchiveView, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="147" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="147"
                                            Height="83"
                                            CornerRadius="7"
                                            Background="#0B1020"
                                            BorderBrush="#4A3A22"
                                            BorderThickness="1"
                                            helpers:CornerRadiusClip.Enabled="True"
                                            SnapsToDevicePixels="True">
                                        <Image Source="{Binding SelectedGame.CoverImage}"
                                               Stretch="UniformToFill"
                                               SnapsToDevicePixels="True"
                                               VerticalAlignment="Top"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGame.Name}"
                                                   Foreground="#F7F1E4"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   FontFamily="Georgia, Times New Roman, Microsoft YaHei UI"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="44" />

                                        <Border Margin="0,8,0,0"
                                                Padding="8,3"
                                                CornerRadius="10"
                                                BorderBrush="{StaticResource ArchiveGoldBrush}"
                                                BorderThickness="1"
                                                Background="#221C12"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Star"
                                                                         Width="11" Height="11"
                                                                         Foreground="{StaticResource ArchiveGoldBrush}"
                                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="已归档"
                                                           Margin="4,0,0,0"
                                                           Foreground="{StaticResource ArchiveGoldBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,2,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.IsStar1Filled}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,2,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.IsStar2Filled}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,2,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.IsStar3Filled}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <materialDesign:PackIcon Width="12" Height="12" Margin="0,0,2,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.IsStar4Filled}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <materialDesign:PackIcon Width="12" Height="12">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.IsStar5Filled}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource ArchiveDetailSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="游玩记录" Style="{StaticResource DetailSectionTitleStyle}" />

                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="ClockOutline"
                                                                     Width="13" Height="13"
                                                                     Foreground="{StaticResource ArchiveMutedBrush}"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="累计游玩时长"
                                                       Style="{StaticResource ArchiveDetailLabelStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedGame.TotalPlayTimeCompactDisplay}"
                                                       Style="{StaticResource ArchiveDetailValueStyle}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Calendar"
                                                                     Width="13" Height="13"
                                                                     Foreground="{StaticResource ArchiveMutedBrush}"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="首次游玩日期"
                                                       Style="{StaticResource ArchiveDetailLabelStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedGame.FirstPlayedDisplay}"
                                                       Style="{StaticResource ArchiveDetailValueStyle}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Calendar"
                                                                     Width="13" Height="13"
                                                                     Foreground="{StaticResource ArchiveMutedBrush}"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="最后游玩日期"
                                                       Style="{StaticResource ArchiveDetailLabelStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedGame.LastPlayedDisplay}"
                                                       Style="{StaticResource ArchiveDetailValueStyle}" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="CalendarStar"
                                                                     Width="13" Height="13"
                                                                     Foreground="{StaticResource ArchiveGoldBrush}"
                                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="归档日期"
                                                       Style="{StaticResource ArchiveDetailLabelStyle}"
                                                       Foreground="{StaticResource ArchiveGoldBrush}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedGame.ArchivedAtDisplay}"
                                                       Style="{StaticResource ArchiveDetailGoldValueStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ArchiveDetailSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="记忆场景" Style="{StaticResource DetailSectionTitleStyle}" />

                                        <Border Height="148"
                                                CornerRadius="6"
                                                Background="#0E1522"
                                                BorderBrush="#243044"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                ToolTip="点击查看大图"
                                                helpers:CornerRadiusClip.Enabled="True">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding SelectedGame.OpenMemorySceneViewerCommand}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <TextBlock Text="图片"
                                                           Foreground="#6B778C"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.HasMemoryScenes}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Image Source="{Binding SelectedGame.CurrentMemorySceneImage}"
                                                       Stretch="UniformToFill"
                                                       Margin="0">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.HasMemoryScenes}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>

                                                <Button Style="{StaticResource MemorySceneNavButtonStyle}"
                                                        Command="{Binding SelectedGame.PrevMemorySceneCommand}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="6,0,0,0"
                                                        ToolTip="上一张"
                                                        Visibility="{Binding SelectedGame.CanNavigateMemoryScenes, Converter={StaticResource BoolToVisibility}}">
                                                    <materialDesign:PackIcon Kind="ChevronLeft"
                                                                             Width="16" Height="16"
                                                                             Foreground="#EAF0FF" />
                                                </Button>

                                                <Button Style="{StaticResource MemorySceneNavButtonStyle}"
                                                        Command="{Binding SelectedGame.NextMemorySceneCommand}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"
                                                        ToolTip="下一张"
                                                        Visibility="{Binding SelectedGame.CanNavigateMemoryScenes, Converter={StaticResource BoolToVisibility}}">
                                                    <materialDesign:PackIcon Kind="ChevronRight"
                                                                             Width="16" Height="16"
                                                                             Foreground="#EAF0FF" />
                                                </Button>

                                                <Border HorizontalAlignment="Center"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,0,8"
                                                        Padding="8,2"
                                                        CornerRadius="10"
                                                        Background="#99101826">
                                                    <TextBlock Text="{Binding SelectedGame.MemorySceneCounterDisplay}"
                                                               Foreground="#D7DEEA"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ArchiveDetailSectionStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="我的评分" Style="{StaticResource DetailSectionTitleStyle}" Margin="0" />
                                            <materialDesign:PackIcon Kind="PencilOutline"
                                                                     Width="14" Height="14"
                                                                     Foreground="{StaticResource ArchiveMutedBrush}"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     ToolTip="点击星星修改评分" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource ArchiveRatingStarButtonStyle}"
                                                    Command="{Binding SelectedGame.SetRatingCommand}"
                                                    CommandParameter="1">
                                                <materialDesign:PackIcon Width="22" Height="22">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.IsStar1Filled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                            <Button Style="{StaticResource ArchiveRatingStarButtonStyle}"
                                                    Command="{Binding SelectedGame.SetRatingCommand}"
                                                    CommandParameter="2">
                                                <materialDesign:PackIcon Width="22" Height="22">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.IsStar2Filled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                            <Button Style="{StaticResource ArchiveRatingStarButtonStyle}"
                                                    Command="{Binding SelectedGame.SetRatingCommand}"
                                                    CommandParameter="3">
                                                <materialDesign:PackIcon Width="22" Height="22">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.IsStar3Filled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                            <Button Style="{StaticResource ArchiveRatingStarButtonStyle}"
                                                    Command="{Binding SelectedGame.SetRatingCommand}"
                                                    CommandParameter="4">
                                                <materialDesign:PackIcon Width="22" Height="22">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.IsStar4Filled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                            <Button Style="{StaticResource ArchiveRatingStarButtonStyle}"
                                                    Command="{Binding SelectedGame.SetRatingCommand}"
                                                    CommandParameter="5">
                                                <materialDesign:PackIcon Width="22" Height="22">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource ArchiveStarIconStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.IsStar5Filled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,12"
                                        Padding="10,14"
                                        CornerRadius="8"
                                        BorderBrush="#3A2F1C"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1A160F" Offset="0" />
                                            <GradientStop Color="#241C12" Offset="0.5" />
                                            <GradientStop Color="#1A160F" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Kind="Trophy"
                                                                 Width="18" Height="18"
                                                                 Foreground="{StaticResource ArchiveGoldBrush}"
                                                                 VerticalAlignment="Center"
                                                                 Opacity="0.85" />

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="感谢这段旅程"
                                                       Foreground="{StaticResource ArchiveGoldBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Georgia, Times New Roman, Microsoft YaHei UI"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="每一份感动都值得被珍藏。"
                                                       Margin="0,4,0,0"
                                                       Foreground="#A8894E"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <materialDesign:PackIcon Grid.Column="2"
                                                                 Kind="Trophy"
                                                                 Width="18" Height="18"
                                                                 Foreground="{StaticResource ArchiveGoldBrush}"
                                                                 VerticalAlignment="Center"
                                                                 Opacity="0.85"
                                                                 RenderTransformOrigin="0.5,0.5">
                                            <materialDesign:PackIcon.RenderTransform>
                                                <ScaleTransform ScaleX="-1" />
                                            </materialDesign:PackIcon.RenderTransform>
                                        </materialDesign:PackIcon>
                                    </Grid>
                                </Border>

                                <Button Command="{Binding SelectedGame.RestoreArchiveCommand}"
                                        Style="{StaticResource PrimaryGameButtonStyle}"
                                        Height="34"
                                        Margin="0,0,0,8"
                                        materialDesign:ButtonAssist.CornerRadius="6">
                                    <TextBlock Text="取消归档"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </Button>

                                <Button Command="{Binding SelectedGame.DeleteCommand}"
                                        Style="{StaticResource ArchiveDeleteButtonStyle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock Text="删除游戏" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>

                <!-- Bottom Status Bar -->
                <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="18,0,18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenSettingsCommand}"
                                Width="25"
                                Height="25"
                                Padding="0"
                                ToolTip="设置"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0">
                            <Border Width="25"
                                    Height="25"
                                    CornerRadius="6"
                                    Background="#10234A"
                                    BorderBrush="#326BF4"
                                    BorderThickness="1">
                                <materialDesign:PackIcon Kind="Cog"
                                                         Width="16"
                                                         Height="16"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#5D8CFF" />
                            </Border>
                        </Button>
                        <TextBlock Text="{Binding TotalGameCountDisplay}"
                                   FontSize="11"
                                   Foreground="#9DA9BF"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalGameTimeDisplay}"
                                   FontSize="11"
                                   Foreground="#9DA9BF"
                                   Margin="22,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Width="46" Height="32"
                                Style="{StaticResource PrimaryGameButtonStyle}"
                                ToolTip="网格视图"
                                Command="{Binding ShowGridViewCommand}"
                                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="/img/网格.png" Style="{StaticResource LayoutToggleIconImageStyle}" />
                        </Button>
                        <Button Width="40" Height="32"
                                Style="{StaticResource GlassButtonStyle}"
                                ToolTip="网格视图"
                                Padding="0"
                                Command="{Binding ShowGridViewCommand}"
                                Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="/img/网格.png" Style="{StaticResource LayoutToggleIconImageStyle}" />
                        </Button>
                        <Button Width="40" Height="32"
                                Margin="6,0,0,0"
                                Style="{StaticResource GlassButtonStyle}"
                                ToolTip="列表视图"
                                Command="{Binding ShowListViewCommand}"
                                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="/img/分类.png" Style="{StaticResource LayoutToggleIconImageStyle}" />
                        </Button>
                        <Button Width="46" Height="32"
                                Margin="6,0,0,0"
                                Style="{StaticResource PrimaryGameButtonStyle}"
                                ToolTip="列表视图"
                                Command="{Binding ShowListViewCommand}"
                                Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="/img/分类.png" Style="{StaticResource LayoutToggleIconImageStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
