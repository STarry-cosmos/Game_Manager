<Window x:Class="Game_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Manager"
        xmlns:viewModels="clr-namespace:Game_Manager.ViewModels"
        mc:Ignorable="d"
        Title="Game Manager" Height="800" Width="1200"
        Background="#FF1E1E1E">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF14151A" Offset="0" />
            <GradientStop Color="#FF1D2636" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="HeaderBackground" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="CardBackground" Color="#FF212936" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#445C7BD8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5294FF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF79A8FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF4F6FA" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FFB0B8C6" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.88" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF5C6474" />
                    <Setter Property="Foreground" Value="#FFCCD7E0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="296" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="0" Opacity="0.3" />
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF272F3F" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.02" ScaleY="1.02" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="{StaticResource HeaderBackground}"
                CornerRadius="18"
                Padding="18"
                Margin="0,10,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="游戏管理" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="点击卡片显示右侧详情" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Command="{Binding AddGameCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="添加游戏"
                        DockPanel.Dock="Right" Width="92" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="4">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="重命名" Command="{Binding RenameCommand}" />
                                    <MenuItem Header="更改封面" Command="{Binding ChangeCoverCommand}" />
                                    <MenuItem Header="打开所在路径" Command="{Binding OpenFolderCommand}" />
                                    <MenuItem Header="删除" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <DockPanel LastChildFill="True" MouseLeftButtonUp="OnCardClicked" Cursor="Hand">
                                <Image Source="{Binding CoverImage}"
                                       Width="216"
                                       Height="120"
                                       Stretch="UniformToFill"
                                       Margin="0,0,0,12"
                                       DockPanel.Dock="Top"
                                       ClipToBounds="True"
                                       SnapsToDevicePixels="True"
                                       VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ExecutablePath}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="40" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="时长："
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentSessionDisplay}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontWeight="SemiBold"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Command="{Binding PlayCommand}"
                                            Margin="0,14,0,0"
                                            Content="启动游戏">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Content" Value="游戏中……" />
                                                        <Setter Property="Background" Value="#FF5A5A5A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1"
                Background="{StaticResource CardBackground}"
                CornerRadius="18"
                Padding="18"
                Margin="12,10,0,10"
                Visibility="{Binding IsGameSelected, Converter={StaticResource BoolToVisibility}}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="游戏详情" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />

                <TextBlock Text="游戏名" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                <TextBlock Text="{Binding SelectedGame.Name}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,12" />

                <TextBlock Text="所在路径" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                <DockPanel Margin="0,4,0,12">
                    <TextBlock Text="{Binding SelectedGame.ExecutablePath}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Width="220"
                               TextTrimming="CharacterEllipsis" />
                    <Button Command="{Binding SelectedGame.OpenFolderCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="打开"
                            Width="72"
                            Margin="8,0,0,0" />
                </DockPanel>

                <TextBlock Text="当前时长" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                <TextBlock Text="{Binding SelectedGame.CurrentSessionDisplay}"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,4,0,20" />

                <TextBlock Text="操作" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                    <Button Command="{Binding SelectedGame.RenameCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="重命名" 
                            Margin="0,0,0,8" />
                    <Button Command="{Binding SelectedGame.ChangeCoverCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="更改封面" 
                            Margin="0,0,0,8" />
                    <Button Command="{Binding SelectedGame.DeleteCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="删除" Background="Red" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
