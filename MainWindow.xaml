<Window x:Class="Game_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:Game_Manager.ViewModels"
        xmlns:converters="clr-namespace:Game_Manager.Converters"
        xmlns:helpers="clr-namespace:Game_Manager.Helpers"
        mc:Ignorable="d"
        Title="Game Manager"
        Height="800" Width="1200"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="Microsoft YaHei UI, Roboto, Segoe UI">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#0B1020" />
        <SolidColorBrush x:Key="ArchiveGoldBrush" Color="#C5A059" />
        <SolidColorBrush x:Key="ArchiveSilverBrush" Color="#B8C0CC" />
        <SolidColorBrush x:Key="ArchiveBronzeBrush" Color="#B87333" />
        <SolidColorBrush x:Key="ArchiveMutedBrush" Color="#8B95A8" />
        <SolidColorBrush x:Key="ArchiveStarEmptyBrush" Color="#3A4558" />
        <SolidColorBrush x:Key="ArchiveRankMutedBrush" Color="#3A4558" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#0A0F1D" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#22304A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8894AA" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#C9D4E8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3D73F5" />
        <LinearGradientBrush x:Key="MainPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121B2D" Offset="0" />
            <GradientStop Color="#0B1222" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172238" Offset="0" />
            <GradientStop Color="#10192A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonBlueBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A82FF" Offset="0" />
            <GradientStop Color="#2F66E8" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B6C0D4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1BFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#C8D5F0" />
            <Setter Property="Background" Value="#14213A" />
            <Setter Property="BorderBrush" Value="#294A82" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
        </Style>

        <Style x:Key="PrimaryGameButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource ButtonBlueBrush}" />
            <Setter Property="BorderBrush" Value="#3F78F6" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="7" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3A455C" />
                    <Setter Property="BorderBrush" Value="#4A566E" />
                    <Setter Property="Foreground" Value="#8A93A8" />
                    <Setter Property="Opacity" Value="0.85" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategorySidebarHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="#00121B2F" />
            <Setter Property="BorderBrush" Value="#001B2A43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#C8D5F0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#172D54" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#263F68" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="archived">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                    <Condition Binding="{Binding Key}" Value="archived" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3D3420" Offset="0" />
                                            <GradientStop Color="#2E2818" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A08848" />
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14233C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#253B62" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#244991" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Key}" Value="archived" />
                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#181510" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Key}" Value="archived" />
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4A3F26" Offset="0" />
                                            <GradientStop Color="#352E1C" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B89A52" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="archived">
                    <Setter Property="Height" Value="56" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Height" Value="42" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryIconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <Style x:Key="CategoryToggleIconImageStyle" TargetType="Image" BasedOn="{StaticResource CategoryIconImageStyle}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>

        <Style x:Key="LayoutToggleIconImageStyle" TargetType="Image" BasedOn="{StaticResource CategoryIconImageStyle}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <Style x:Key="CategoryCollapsedIconImageStyle" TargetType="Image" BasedOn="{StaticResource CategoryIconImageStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryCollapsedFallbackIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="GamepadVariant" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="#6E92F5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="archived">
                    <Setter Property="Kind" Value="BookOpenPageVariant" />
                    <Setter Property="Foreground" Value="#D4B45A" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                        <Condition Binding="{Binding IconPath}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryExpandedIconImageStyle" TargetType="Image" BasedOn="{StaticResource CategoryIconImageStyle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryExpandedFallbackIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="GamepadVariant" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#6E92F5" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="archived">
                    <Setter Property="Kind" Value="BookOpenPageVariant" />
                    <Setter Property="Foreground" Value="#D4B45A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryExpandedContentStyle" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryToggleExpandedStyle" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryToggleCollapsedIconStyle" TargetType="Image" BasedOn="{StaticResource CategoryToggleIconImageStyle}">
            <Setter Property="Source" Value="/img/分类.png" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategorySidebarTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryItemTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryArchiveTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CategoryItemTextStyle}">
            <Setter Property="Foreground" Value="#E5BA61" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="archived">
                    <Setter Property="Foreground" Value="#E5BA61" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ArchiveSidebarDockStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ArchiveSidebarVisualStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategorySidebarExpandedPanelStyle" TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategorySidebarCollapsedPanelStyle" TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategorySidebarScrollItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="archived">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategorySidebarArchivedItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="archived">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CategorySidebarItemTemplate">
            <StackPanel>
                <Border Height="1"
                        Margin="8,6,8,10"
                        Background="#2A3A55">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Key}" Value="archived">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Button Style="{StaticResource CategoryButtonStyle}"
                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                        VerticalContentAlignment="Center">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="重命名分类"
                                      Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                                      Command="{Binding PlacementTarget.Tag.RenameCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="删除分类"
                                      Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                                      Foreground="#FFEF5350"
                                      Command="{Binding PlacementTarget.Tag.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Image Source="{Binding IconPath}"
                               Style="{StaticResource CategoryCollapsedIconImageStyle}" />
                        <materialDesign:PackIcon Style="{StaticResource CategoryCollapsedFallbackIconStyle}" />
                        <Grid Style="{StaticResource CategoryExpandedContentStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding IconPath}"
                                   Style="{StaticResource CategoryExpandedIconImageStyle}" />
                            <materialDesign:PackIcon Style="{StaticResource CategoryExpandedFallbackIconStyle}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryItemTextStyle}">
                                            <Setter Property="Foreground" Value="#EAF0FF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Key}" Value="archived">
                                                    <Setter Property="Foreground" Value="#D4B45A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="收藏美好回忆"
                                           FontSize="10"
                                           Foreground="#9A8048"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryItemTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Key}" Value="archived">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.IsCategorySidebarCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CountDisplay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CategoryItemTextStyle}">
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Key}" Value="archived">
                                                <Setter Property="Foreground" Value="#C9A84A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Button>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="DetailSectionStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#121E32" />
            <Setter Property="BorderBrush" Value="#263856" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DetailSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F6FF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="DetailInfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA8BD" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailInfoValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EFFD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="DetailMiniActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="#5E97FF" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
        </Style>

        <Style x:Key="DetailSecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#1A2943" />
            <Setter Property="BorderBrush" Value="#1A2943" />
            <Setter Property="Foreground" Value="#EAF0FF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="5" />
        </Style>

        <Style x:Key="DetailDangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#EF3340" />
            <Setter Property="BorderBrush" Value="#EF3340" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="5" />
        </Style>

        <Style x:Key="ArchiveDetailSectionStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#141B28" />
            <Setter Property="BorderBrush" Value="#243044" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ArchiveDetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ArchiveMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ArchiveDetailValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F6FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ArchiveDetailGoldValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ArchiveDetailValueStyle}">
            <Setter Property="Foreground" Value="{StaticResource ArchiveGoldBrush}" />
        </Style>

        <Style x:Key="ArchiveStarIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="Star" />
            <Setter Property="Foreground" Value="{StaticResource ArchiveStarEmptyBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ArchiveRatingStarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="#1A2333" />
            <Setter Property="BorderBrush" Value="#2A364C" />
            <Setter Property="Foreground" Value="#EAF0FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
        </Style>

        <Style x:Key="MemorySceneNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#99141B28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC1A2333" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveListRowStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#121925" />
            <Setter Property="BorderBrush" Value="#243044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#182233" />
                    <Setter Property="BorderBrush" Value="#3A4A62" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ArchiveGoldBrush}" />
                    <Setter Property="Background" Value="#1A2118" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ArchiveRankBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="4,4,8,8" />
            <Setter Property="Background" Value="{StaticResource ArchiveRankMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ArchiveRankTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EEF8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ArchiveGridRankBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="0,0,6,6" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Background" Value="{StaticResource ArchiveRankMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="ArchiveListMedalImageStyle" TargetType="Image">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <Style x:Key="ArchiveGridMedalImageStyle" TargetType="Image">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <Style x:Key="ArchiveViewToggleActiveStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#1A1408" />
            <Setter Property="Background" Value="{StaticResource ArchiveGoldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ArchiveGoldBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveViewToggleInactiveStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#C8D0DE" />
            <Setter Property="Background" Value="#182233" />
            <Setter Property="BorderBrush" Value="#2A364C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArchiveGridCardStyle" TargetType="Border">
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#141B28" />
            <Setter Property="BorderBrush" Value="#243044" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="helpers:CornerRadiusClip.Enabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ArchiveGoldBrush}" />
                    <Setter Property="Background" Value="#1A2333" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#C5A059" BlurRadius="16" ShadowDepth="0" Opacity="0.35" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ArchiveGoldBrush}" />
                    <Setter Property="Background" Value="#1A2118" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" 
                      
                      />
    </WindowChrome.WindowChrome>

    <!-- Outer container with padding for shadow -->
    <Grid x:Name="RootGrid" Margin="8">
        <!-- Shadow + rounded corners -->
        <Border CornerRadius="14"
                Background="{StaticResource PageBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="22"
                                  Opacity="0.55" Color="#05070D" />
            </Border.Effect>
        </Border>

        <!-- Content (same rounded corners, clips children) -->
        <Border x:Name="ContentBorder" CornerRadius="14"
                Background="{StaticResource PageBackgroundBrush}">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,1184,784" RadiusX="14" RadiusY="14" />
            </Border.Clip>
            <Grid Background="{StaticResource PageBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <!-- 详情栏：未选中游戏时收为 0，把宽度让给游戏列表（网格/列表布局都吃可用宽度，自动适配） -->
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGameSelected}" Value="True">
                                        <Setter Property="Width" Value="350" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!-- Custom Title Bar -->
                <Grid Grid.Row="0" Grid.ColumnSpan="3"
                      Background="{StaticResource TitleBarBrush}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel LastChildFill="False">
                        <!-- App title -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                    VerticalAlignment="Center" Margin="14,0,0,0">
                            <Ellipse Width="4" Height="4" Fill="#39496A" VerticalAlignment="Center" />
                            <Ellipse Width="4" Height="4" Fill="#39496A" VerticalAlignment="Center" Margin="4,0,8,0" />
                            <TextBlock Text="Game Manager"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#CAD4E8"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Window control buttons -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right">
                            <Button Click="MinimizeButton_Click"
                                    Width="36" Height="32"
                                    ToolTip="最小化"
                                    Style="{StaticResource ChromeButtonStyle}">
                                <materialDesign:PackIcon Kind="WindowMinimize"
                                                         Width="13" Height="13"
                                                         Foreground="#AEB8CC" />
                            </Button>
                            <Button x:Name="MaximizeBtn"
                                    Click="MaximizeButton_Click"
                                    Width="36" Height="32"
                                    ToolTip="最大化"
                                    Style="{StaticResource ChromeButtonStyle}">
                                <materialDesign:PackIcon x:Name="MaxIcon"
                                                         Kind="WindowMaximize"
                                                         Width="12" Height="12"
                                                         Foreground="#AEB8CC" />
                            </Button>
                            <Button Click="CloseButton_Click"
                                    Width="40" Height="32"
                                    ToolTip="关闭"
                                    Style="{StaticResource ChromeButtonStyle}">
                                <materialDesign:PackIcon Kind="WindowClose"
                                                         Width="13" Height="13"
                                                         Foreground="#AEB8CC" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Header -->
                <Border Grid.Row="1" Grid.ColumnSpan="3"
                        Margin="12,12,12,0"
                        Padding="16,12"
                        CornerRadius="12"
                        Background="{StaticResource MainPanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Width="38" Height="38"
                                    CornerRadius="10"
                                    Background="#10234A"
                                    BorderBrush="#326BF4"
                                    BorderThickness="1.5">
                                <materialDesign:PackIcon Kind="GamepadVariant"
                                                         Width="24" Height="24"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#5D8CFF" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="游戏管理"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#F4F7FF" />
                                <TextBlock Text="管理你的游戏库，启动精彩游戏"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Height="51">
                            <Border Width="185"
                                    Height="46"
                                    Margin="0,0,12,0"
                                    CornerRadius="7"
                                    Background="#0D1526"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Magnify"
                                                             Width="16" Height="16"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="搜索游戏..."
                                             Style="{StaticResource MaterialDesignTextBox}"
                                             FontSize="11"
                                             Foreground="#D8E2F8"
                                             CaretBrush="#5D8CFF"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>
                            <ComboBox Width="142"
                                      Height="46"
                                      Margin="0,0,12,0"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}"
                                      Padding="10,0"
                                      Foreground="#D8E2F8"
                                      Background="#0D1526"
                                      BorderBrush="{StaticResource PanelBorderBrush}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            <Button Command="{Binding ToggleSortDirectionCommand}"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Width="90"
                                    Margin="0,0,12,0"
                                    IsEnabled="{Binding IsSortDirectionEnabled}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Sync" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SortDirectionLabel}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddGameCommand}"
                                    Style="{StaticResource PrimaryGameButtonStyle}"
                                    Width="100"
                                    Padding="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="83">
                                    <materialDesign:PackIcon Kind="PlusCircle" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="添加游戏" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Category Sidebar -->
                <Border x:Name="CategorySidebar"
                        Grid.Row="2" Grid.Column="0"
                        Width="190"
                        Margin="12,12,0,0"
                        Padding="10"
                        CornerRadius="12"
                        Background="#0E192B"
                        BorderBrush="#243452"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="0" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button Height="34"
                                    Padding="0"
                                    Style="{StaticResource CategorySidebarHeaderButtonStyle}"
                                    Click="ToggleCategorySidebarButton_Click"
                                    ToolTip="收缩分类栏"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">
                                    <Grid Style="{StaticResource CategoryToggleExpandedStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="分类"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#EAF0FF"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   Style="{StaticResource CategorySidebarTextStyle}" />
                                        <Image Grid.Column="1"
                                               Source="/img/分类.png"
                                               Margin="0,0,10,0"
                                               Style="{StaticResource CategoryToggleIconImageStyle}" />
                                    </Grid>
                                    <Image Style="{StaticResource CategoryToggleCollapsedIconStyle}" />
                                </Grid>
                            </Button>
                            <TextBlock Text="按分类查看游戏"
                                       FontSize="10"
                                       Foreground="{StaticResource SoftTextBrush}"
                                       Margin="12,6,0,0"
                                       Style="{StaticResource CategorySidebarTextStyle}" />
                        </StackPanel>

                        <!-- 分类区域：可滚动、无滚动条，不与底部归档区重叠 -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,2,0,8"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False"
                                      Style="{StaticResource CategorySidebarExpandedPanelStyle}">
                            <ItemsControl ItemsSource="{Binding Categories}"
                                          ItemTemplate="{StaticResource CategorySidebarItemTemplate}"
                                          ItemContainerStyle="{StaticResource CategorySidebarScrollItemContainerStyle}" />
                        </ScrollViewer>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,2,0,8"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Style="{StaticResource CategorySidebarCollapsedPanelStyle}">
                            <ItemsControl ItemsSource="{Binding Categories}"
                                          ItemTemplate="{StaticResource CategorySidebarItemTemplate}" />
                        </ScrollViewer>

                        <!-- 归档区域：未选中时按钮固定底部且隐藏背景图；选中后展开并显示背景图 -->
                        <StackPanel Grid.Row="2"
                                    Style="{StaticResource ArchiveSidebarDockStyle}">
                            <ItemsControl ItemsSource="{Binding Categories}"
                                          ItemTemplate="{StaticResource CategorySidebarItemTemplate}"
                                          ItemContainerStyle="{StaticResource CategorySidebarArchivedItemContainerStyle}" />

                            <Border x:Name="ArchiveBackgroundPanel"
                                    Height="0"
                                    CornerRadius="0,0,12,12"
                                    ClipToBounds="True"
                                    Background="#0E192B"
                                    BorderThickness="0"
                                    Margin="0"
                                    Style="{StaticResource ArchiveSidebarVisualStyle}">
                                <Grid>
                                    <Image Source="/img/档案.jpg"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.9"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF0E192B" Offset="0" />
                                                <GradientStop Color="#E60E192B" Offset="0.12" />
                                                <GradientStop Color="#990E192B" Offset="0.28" />
                                                <GradientStop Color="#330E192B" Offset="0.48" />
                                                <GradientStop Color="#000E192B" Offset="0.68" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle VerticalAlignment="Bottom" Height="150">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#000E192B" Offset="0.0" />
                                                <GradientStop Color="#330E192B" Offset="0.3" />
                                                <GradientStop Color="#990E192B" Offset="0.6" />
                                                <GradientStop Color="#E60E192B" Offset="0.85" />
                                                <GradientStop Color="#FF0E192B" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Game Cards ScrollViewer -->
                <Border Grid.Row="2" Grid.Column="1"
                        Padding="10,8"
                        CornerRadius="10"
                        Background="{StaticResource MainPanelBrush}"
                        BorderBrush="#1D2A42"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- 详情栏收起时补 16px 右边距，与详情卡自身的右边距保持一致 -->
                            <Setter Property="Margin" Value="8,12,16,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGameSelected}" Value="True">
                                    <Setter Property="Margin" Value="8,12,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Normal category header -->
                    <StackPanel Orientation="Horizontal"
                                Margin="4,0,0,8"
                                Visibility="{Binding IsArchiveView, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding CurrentCategoryName}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#F4F7FF"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentCategoryGameCountDisplay}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="6,1,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Archive category header -->
                    <Grid Margin="4,2,4,12"
                          Visibility="{Binding IsArchiveView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookOpenPageVariant"
                                                         Width="22" Height="22"
                                                         Foreground="{StaticResource ArchiveGoldBrush}"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="已归档"
                                           Margin="8,0,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ArchiveGoldBrush}"
                                           FontFamily="Georgia, Times New Roman, Microsoft YaHei UI"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="这里收藏着你已经完成的旅程，每一款游戏都是珍贵的回忆。"
                                       Margin="30,6,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource ArchiveMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,18,0">
                            <TextBlock Text="共收藏 "
                                       Foreground="{StaticResource ArchiveMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ArchiveGameCount}"
                                       Foreground="{StaticResource ArchiveGoldBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" 款游戏"
                                       Foreground="{StaticResource ArchiveMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <Border Width="1"
                                    Height="12"
                                    Margin="10,0"
                                    Background="#3A4558"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="累计陪伴你 "
                                       Foreground="{StaticResource ArchiveMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ArchiveTotalHoursDisplay}"
                                       Foreground="{StaticResource ArchiveGoldBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" 小时"
                                       Foreground="{StaticResource ArchiveMutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding ShowListViewCommand}"
                                    Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ArchiveViewToggleInactiveStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListView}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ArchiveGoldBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource ArchiveGoldBrush}" />
                                                <Setter Property="Foreground" Value="#1A1408" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewList"
                                                             Width="14" Height="14"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="列表" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center" />
